  010d  ad43     bsr    delay_A                     
  010f  ad2d     bsr    chk_ram_config              
  0111  3f3b     clr    $3b                         
  0113  3f3c     clr    $3c                         
  0115  131a     bclr   1, $1a                      
  0117  b620     lda    $20                         
  0119  1b04     bclr   5, $04                      
  011b  0a000a   brset  5, $00, L_0128              ; PA5 = on/off switch sense; $20 = power state (0x11 off, 0x99 on)
  011e  a111     cmp    #$11                        ; PA5 low (supply glitch): stay off if off, carry on if on
  0120  2767     beq    power_down_stop             
  0122  a199     cmp    #$99                        
  0124  2636     bne    cold_start                  
  0126  200e     bra    L_0136                      

L_0128:    ; xref 011b
