ctcss_decode_task:    ; xref 0d64 0d7f
  0dd2  013023   brclr  0, $30, L_0df8              ; CTCSS decode, Rx only: $30 = 0x1F34 bit0 CTCSS fitted, bit2 decode; $34 bits 0-5 = channel tone
  0dd5  053020   brclr  2, $30, L_0df8              
  0dd8  b634     lda    $34                         
  0dda  a53f     bit    #$3f                        
  0ddc  271a     beq    L_0df8                      
  0dde  081907   brset  4, $19, L_0de8              ; $19.4 = squelch open; $82 bit2 low = tone detected (inferred); $1B.5 = C/R channel
  0de1  1716     bclr   3, $16                      
  0de3  0a1b0f   brset  5, $1b, L_0df5              ; no carrier: mute; on a C/R channel monitor ($11.4) does not open it
  0de6  200a     bra    L_0df2                      

L_0de8:    ; xref 0dde
  0de8  05820d   brclr  2, $82, L_0df8              
  0deb  0b1b04   brclr  5, $1b, L_0df2              
  0dee  1616     bset   3, $16                      ; carrier, wrong/no tone, C/R channel: $16.3 = busy lockout (blocks Tx via tx_inhibited)
  0df0  2003     bra    L_0df5                      

