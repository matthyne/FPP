  012a  275d     beq    power_down_stop             
  012c  a111     cmp    #$11                        
  012e  262c     bne    cold_start                  
  0130  a699     lda    #$99                        
  0132  b720     sta    $20                         
  0134  1a2a     bset   5, $2a                      ; latch $2A bit 5 set only while on (switched supply enable, inferred)

